#pragma package(smart_init)

void Display::desenha(TCanvas *canvas, Janela vp, Janela mundo){

   canvas->Brush->Color = clWhite;
   canvas->FillRect(Rect(0,0,500,500));

   canvas->Pen->Color = clBlack;
   canvas->Pen->Width = 1;

   for (int i = 0; i < poligonos.size(); i++) {
	  poligonos[i].desenha(canvas, vp, mundo);
   }
}

void Display::mostra(TListBox *listBox){
   listBox->Items->Clear();
   for (int i = 0; i < poligonos.size(); i++) {
	  listBox->Items->Add(
		 IntToStr(poligonos[i].id) + "-" +
		 poligonos[i].tipo + "-" +
		 IntToStr((int)poligonos.[i].pontos.size()));
   }
}

Poligono::Poligono(){
	tipo = 'N';
}
