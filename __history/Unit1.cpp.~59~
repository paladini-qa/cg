void __fastcall TForm1::Button2Click(TObject *Sender)
{
	// Salva o estado atual antes de aplicar o zoom in
	historicoMundo.push(mundo);

	mundo.xMin = StrToFloat(edXmin->Text);
	mundo.yMin = StrToFloat(edYmin->Text);
	mundo.xMax = StrToFloat(edXmax->Text);
	mundo.yMax = StrToFloat(edYmax->Text);
	// Recria eixos para cobrir o novo mundo
	recriaEixos();
	display.desenha(Image1->Canvas, vp, mundo, tipoReta);
}
//---------------------------------------------------------------------------

void __fastcall TForm1::RadioGroup1Click(TObject *Sender)
{
	tipoReta = RadioGroup1->ItemIndex;
	display.desenha(Image1->Canvas, vp, mundo, tipoReta);
}
//---------------------------------------------------------------------------

void __fastcall TForm1::Button3Click(TObject *Sender)
{
	// Remove todos os polígonos exceto os eixos (tipo 'E')
	std::vector<Poligono> eixos;
	for (int i = 0; i < (int)display.poligonos.size(); i++) {
		if (display.poligonos[i].tipo == 'E')
			eixos.push_back(display.poligonos[i]);
	}
	display.poligonos = eixos;

	// Reseta o polígono em construção e o estado
	pol.pontos.clear();
	inicio = false;

	// Limpa as ListBoxes
	ListBox1->Items->Clear();
	lbPoligonos->Items->Clear();

	// Redesenha apenas os eixos
	display.desenha(Image1->Canvas, vp, mundo, tipoReta);
}
//---------------------------------------------------------------------------
void __fastcall TForm1::Button4Click(TObject *Sender)
{
	// Restaura o mundo anterior ao último Zoom In
	if (!historicoMundo.empty()) {
		mundo = historicoMundo.top();
		historicoMundo.pop();

		// Atualiza os campos de edição com os valores restaurados
		edXmin->Text = FloatToStr(mundo.xMin);
		edXmax->Text = FloatToStr(mundo.xMax);
		edYmin->Text = FloatToStr(mundo.yMin);
		edYmax->Text = FloatToStr(mundo.yMax);

		// Recria eixos e redesenha
		recriaEixos();
		display.desenha(Image1->Canvas, vp, mundo, tipoReta);
	}
}
