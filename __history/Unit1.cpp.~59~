void __fastcall TForm1::Button5Click(TObject *Sender)
{
	// Lê os valores de translação
	double dx = StrToFloatDef(Edit1->Text, 0.0);
	double dy = StrToFloatDef(Edit2->Text, 0.0);

	// Verifica se há um polígono selecionado na listbox
	int idx = lbPoligonos->ItemIndex;

	if (idx != -1) {
		// Aplica translação apenas no polígono selecionado (ignora eixos)
		if (display.poligonos[idx].tipo != 'E') {
			display.poligonos[idx].translada(dx, dy);
		}
	} else {
		// Aplica em todos os polígonos (exceto eixos)
		for (int i = 0; i < (int)display.poligonos.size(); i++) {
			if (display.poligonos[i].tipo != 'E') {
				display.poligonos[i].translada(dx, dy);
			}
		}
	}

	// Redesenha e atualiza a listbox de pontos
	display.desenha(Image1->Canvas, vp, mundo, tipoReta);
	if (idx != -1) {
		display.poligonos[idx].mostra(ListBox1);
	}
}
